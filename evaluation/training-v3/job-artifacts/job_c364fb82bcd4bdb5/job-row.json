  "scope_spans": [
    {
      "text": "The position requires proven abilities to drive both strategic and measurable business outcomes. The incumbent’s Oncology track record expertise is required to be extensive and ensure recognition as peer of their Pharmaceutical Industry equivalents. This position is playing a key part in the future success of the PPD clinical research business of Thermo Fisher Scientific, as it seeks to continue its track record of successful growth and expand Industry leading position in Oncology. Medical Science & Strategy physicians are subject matter experts who support sales for proposals and bid defenses, engaging clients senior medical / scientific leadership in discussions and training internal staff on medical and therapeutic requirements of the proposals.",
      "char_start": 1313,
      "char_end": 2071
    },
    {
