      "scope_spans": [
        {
          "text": "Johnson Controls is hiring a Director of Government Relations, to provide dynamic and effective leadership of the company’s public policy and advocacy efforts throughout China. Reporting to the Vice President & Chief Sustainability and External Relations Officer, and Government Relations Director, and part of a collaborative, diverse, global team, this person will assist in the development and execution of policy campaigns, projects, and initiatives critical to the company’s success on issues including energy, environment, government contracting, government subsidies and technology development.",
          "char_start": 220,
          "char_end": 821
        },
        {
          "text": "Ensure the establishment, development, and maintenance of effective working relationships with central, provincial and municipal government officials and government agencies.",
          "char_start": 844,
          "char_end": 1018
        },
        {
          "text": "Lead the development and execution of policy and regulatory strategies, orchestrate advocacy campaigns, and monitor progress.",
          "char_start": 1019,
          "char_end": 1144
        }
