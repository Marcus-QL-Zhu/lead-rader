# Install only after the protected env file and stable release symlink exist.
# This file contains paths and variable names only; never place secret values here.
CRON_TZ=Asia/Shanghai
HT_LEAD_ENV_FILE=/home/admin/.openclaw/secrets/lead-radar.env

0 5 * * * /home/admin/.openclaw/workspace/skills/hardtech-lead-radar/scripts/run_daily_fixed_sources.sh >> /home/admin/.openclaw/workspace/skills/hardtech-lead-radar-state/logs/daily-cron.log 2>&1

# Reconciliation remains exactly 05:50 and 06:50 Asia/Shanghai.
# Run reconciliation directly: agent cron success is not report delivery success.
50 5,6 * * * env PATH=/home/admin/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin OPENCLAW_HOME=/home/admin OPENCLAW_CONFIG_PATH=/home/admin/.openclaw/openclaw.json /home/admin/.pyenv/versions/3.11.14/bin/python3 -B /home/admin/.openclaw/workspace/skills/hardtech-lead-radar/scripts/openclaw_daily_report.py --state-db /home/admin/.openclaw/workspace/skills/hardtech-lead-radar/data/talent-pool.sqlite wake --source scheduled-reconcile --openclaw-bin /home/admin/.local/share/pnpm/openclaw >> /home/admin/.openclaw/workspace/skills/hardtech-lead-radar-state/logs/report-reconcile.log 2>&1
# Disable old OpenClaw report reconciliation cron before enabling this line.
